# =============================================================================
# AprenderAI - .gitignore
# =============================================================================

# Dependências
**/node_modules/
**/vendor/

# Arquivos de Ambiente e Credenciais
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.cert
apikey*.txt
credentials*.json

# Logs, Dumps e Bancos de Dados
*.log
*.sql
*.dump
*.sqlite
*.sqlite3
*.bak
*.swp
*.swo

# Scraper & Scripts Locais Temporários
scraper/
scraper.py
enem-test-data/
tmp/
temp/
scratch/

# Testes, Caches e Builds
.phpunit.result.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & SO
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# Laravel Backend
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/*.sqlite
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Frontend
frontend/dist/
frontend/node_modules/
frontend/*.png
frontend/evidence_*.png
frontend/screenshot*.js
frontend/screenshot*.mjs
docker-compose.override.yml
