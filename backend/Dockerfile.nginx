# --- STAGE 0: Get the app built assets ---
# We use the app image as a source
FROM aprender-ai-app AS app-source

# --- STAGE 1: Nginx Configuration ---
FROM nginx:stable-alpine

# Copy the public directory (React build + Laravel index.php)
# This directory contains the static assets and the entry point for PHP-FPM
COPY --from=app-source /var/www/public /var/www/public

# Copy the nginx config directly into the image
COPY backend/nginx.conf /etc/nginx/conf.d/default.conf

# Clean up any default configs
RUN rm -rf /etc/nginx/conf.d/default.conf.dpkg-dist
